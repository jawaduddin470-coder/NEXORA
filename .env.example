# ===================================================
# NEXORA FRONTEND ENVIRONMENT VARIABLES (Vite / Public)
# ===================================================
# Firebase Client SDK Configuration (Safe for frontend exposure)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API Base URL
# Development: http://localhost:5001/api (or leave empty for Vite proxy /api)
# Production (Vercel): leave empty or /api for same-origin serverless routing
VITE_API_BASE_URL=

# ===================================================
# NEXORA BACKEND ENVIRONMENT VARIABLES (Server-side Only)
# ===================================================
# NEVER expose these to the frontend or commit them to git
PORT=5001
NODE_ENV=production

# Firebase Admin SDK Credentials (Required for transactions & admin operations)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Optional CORS / Deployment Domain Configuration
FRONTEND_URL=https://your-nexora-app.vercel.app

# Initial Admin Bootstrap Credentials (Optional / Seed script only)
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=your_secure_admin_password
